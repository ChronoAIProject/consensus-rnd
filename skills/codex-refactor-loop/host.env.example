# host.env — codex-refactor-loop 的 host runtime injection file(模板)
#
# 这个 skill 不写死任何具体项目的事实;host 仓库通过本文件注入 loop runtime
# facts。Host production config / branch topology / ledger SSOT 必须留在 host-owned
# config、rules 或 artifacts,不得放进 skill-private .refactor-loop runtime home。
#
# Recommended:复制到 host-owned path,并通过 CONSENSUS_RND_HOST_ENV 指向它。
#   mkdir -p <host-repo>/.config/consensus-rnd
#   cp skills/codex-refactor-loop/host.env.example <host-repo>/.config/consensus-rnd/host.env
#   $EDITOR <host-repo>/.config/consensus-rnd/host.env
#   export CONSENSUS_RND_HOST_ENV=.config/consensus-rnd/host.env
#
# ⚠️ daemon / codex 启动必须用 `bash -c 'source "$CONSENSUS_RND_HOST_ENV" && exec ...'` 注入(见 SKILL.md
#    「Daemon 启动」节),不能用 `env $(grep ... host.env)` —— 含空格的值(如
#    BUILD_CMD="cargo build --workspace")会被 env 当成 "build" 是命令而崩。
#
# Refactor (iter1/issue-170):
#   Old pattern: host.env contract facts were split across prose tables and
#   template comments, so categories, defaults, consumers, and test ownership
#   could drift.
#   New principle: SKILL.md owns one host.env surface matrix; host.env.example is
#   a copyable template view; tests mechanically derive exported keys,
#   categories, defaults, prompt placeholders, and runtime literal anchors from
#   that matrix.

# ─── required ─────────────────────────────────────────────────────

# Requirement: host 仓库根(绝对路径); missing means bootstrap fails closed.
export REPO_ROOT="/abs/path/to/your/repo"

# Requirement: GitHub 完整 slug,OWNER/REPO 格式; required by gh --repo.
# Do not export bare GH_REPO=<repo-name>; gh requires OWNER/REPO.
export GH_REPO_SLUG="your-org/your-repo"

# Requirement: shell command string for build. May contain `cd`, `&&`, pipes,
# and other shell syntax. Callers must execute it from a sourced host.env shell
# with `bash -lc "$BUILD_CMD"` or an equivalent shell invocation, never by
# splitting it into argv. Long flows may be wrapped in a host script.
export BUILD_CMD="cargo build --workspace"        # example: bash scripts/build.sh

# Requirement: shell command string for tests; same execution contract as
# BUILD_CMD. Callers use `bash -lc "$TEST_CMD"`. Dogfood must use unittest discovery.
# Rust host 提示:shared fs 状态并行会 race 出假失败,带 --test-threads=1。
export TEST_CMD="cargo test --workspace -- --test-threads=1"

# Requirement: 集成分支; cluster PRs land here before rollup to review base.
export INTEGRATION_BRANCH="your-integration-branch"

# Requirement: review 基线分支(rollup PR 的目标;日常人审从这里看)。
export REVIEW_BASE_BRANCH="your-review-base-branch"

# ─── defaulted ────────────────────────────────────────────────────

# Default: audit/review codex 读的规则文档; Phase 0 maintains fixed points.
export PROJECT_RULES="CLAUDE.md"

# Default: release auto gate opt-in; false/empty exits 0 with noop reason.
export RELEASE_AUTO_ENABLE="false"

# Default: host-owned exact GitHub check-run names required before automatic release.
export HOST_GITHUB_RELEASE_REQUIRED_CHECKS="ci,lint,typecheck"

# Default/noop: notify-only skill update check; false/empty exits 0 with noop reason.
export UPDATE_CHECK_ENABLE="false"

# Default: minimum seconds between manual update-check probes.
export UPDATE_CHECK_INTERVAL_SECONDS="21600"

# Default: GitHub release/tag read timeout seconds.
export UPDATE_CHECK_TIMEOUT_SECONDS="5"

# Default/noop: RuntimeRetention local cleanup opt-in. False/empty does nothing.
export RUNTIME_RETENTION_ENABLE="false"

# Default/noop: hard-gate audit fallback spawn opt-in. False/empty/invalid keeps
# audit as recommendation/status only; true/1/yes/on enables fallback spawning.
export AUDIT_FALLBACK_ENABLE="false"

# Default: minimum recent merges required by auto_release_gate stability.
export RELEASE_AUTO_MIN_MERGES="1"

# Default: minimum hours since last release before auto release decision.
export RELEASE_AUTO_MIN_INTERVAL_HOURS="2"

# Default: minimum integration-ahead commits before release-rollup pending event.
export RELEASE_ROLLUP_MIN_COMMITS="1"

# Default: suppress duplicate release-rollup events for same integration SHA.
export RELEASE_ROLLUP_COOLDOWN_SECONDS="21600"

# Default: rollup PR CI-only squash merge. Use manual/false to leave rollup PRs
# open for human review or host branch-protection requirements.
export ROLLUP_AUTO_MERGE="auto"

# Default: concurrency floor; unset means 5 and values below 2 are clamped to 2.
export CODEX_FLOOR="5"

# Default: idle hours after which a stuck managed work item is re-triggered
# (its blocking redispatchable local evidence is cleared). Missing, invalid, or
# non-positive means 3 hours.
export STALE_REVIVAL_HOURS="3"

# Default: repository-wide long-stuck meta-reflector threshold in hours.
# Missing, invalid, or non-positive means 3h; effective threshold is max with
# STALE_REVIVAL_HOURS so this fallback is not earlier than ordinary stale revival.
export META_ESCALATION_STUCK_HOURS="3"

# Default/noop: active-controller lease device id. Empty means single-device
# local-owner noop. Multi-device opt-in requires all devices upgraded and each
# device configured with a stable unique id.
export ACTIVE_CONTROLLER_DEVICE_ID=""

# Default: active-controller lease TTL in seconds.
export ACTIVE_CONTROLLER_TTL_SECONDS="1800"

# Default: open managed work snapshot fresh-cache TTL in seconds.
export MANAGED_WORK_SNAPSHOT_TTL_SECONDS="300"

# Default: maximum stale snapshot age reused during low GraphQL headroom or
# transient fetch failure.
export MANAGED_WORK_SNAPSHOT_STALE_MAX_SECONDS="900"

# Default: restart-helper-managed phase9-router daemon tick seconds.
export PHASE9_ROUTER_INTERVAL_SECONDS="120"

# Default: restart-helper-managed wakeup-runner daemon tick seconds.
export WAKEUP_RUNNER_INTERVAL_SECONDS="120"

# Default: patrol-inspector issue intake daemon opt-in. False/empty keeps local
# patrol state disabled and does not publish patrol-owned issues.
export PATROL_INSPECTOR_ENABLE="true"

# Default: restart-helper-managed patrol-inspector daemon tick seconds.
export PATROL_INSPECTOR_INTERVAL_SECONDS="7200"

# Default/noop: narrow controller tick supervisor migration surface. False/empty
# keeps the legacy restart-helper-managed daemon list unchanged.
export CONTROLLER_TICK_SUPERVISOR_ENABLE="false"

# Default: maximum PatrolFinding records published per patrol tick.
export PATROL_INSPECTOR_MAX_FINDINGS="25"

# Default: comment-monitor tick seconds. Higher values lower fixed search cost;
# unchanged issue/PR updatedAt values now skip comments queries entirely.
export COMMENT_MONITOR_INTERVAL="30"

# Empty/noop: optional GitHub updated: lookback qualifier for comment-monitor
# search only. Plain dates become updated:>=DATE; empty adds no filter.
export COMMENT_MONITOR_LOOKBACK=""

# Default/noop: shared holistic status card GitHub sync. False/empty keeps the
# local read-only `holistic-status` command available but disables issue-comment
# PATCH from progress-reporter.
export HOST_HOLISTIC_STATUS_ENABLE="false"

# Empty/noop: host issue number that owns the existing dashboard comment.
export HOST_HOLISTIC_STATUS_ISSUE_NUMBER=""

# Empty/noop: existing issue comment id to PATCH in place. The skill never
# creates this comment.
export HOST_HOLISTIC_STATUS_COMMENT_ID=""

# Default: minimum seconds between fixed-comment PATCH attempts.
export HOST_HOLISTIC_STATUS_INTERVAL_SECONDS="600"

# Default: refactor-history source comment policy. Valid values:
# none, self-doc-comment. Empty is treated as none.
export HOST_REFACTOR_COMMENT_POLICY="none"

# ─── optional-empty-or-noop / compatibility / conditional-fail-closed ─

# Compatibility/noop: owner used only when GH_REPO_SLUG is absent.
export GH_OWNER="your-org"

# Compatibility/noop: repo name used only when GH_REPO_SLUG is absent.
export GH_REPO_NAME="your-repo"

# Empty/noop: CI 守卫脚本; leave empty to skip with reported noop reason.
export CI_GUARDS=""                               # 例:scripts/ci-guards.sh

# Empty/infer: test file glob hints; infer from existing tests when empty.
export HOST_TEST_FILE_GLOBS=""

# Empty/infer: test naming rule; mirror existing tests when empty.
export HOST_TEST_NAMING_RULE=""

# Empty/infer: comment syntax/applicability; match surrounding style when empty.
export HOST_COMMENT_RULE=""

# Empty/infer: illustrative code fence language; omit language tag when empty.
export HOST_CODE_FENCE_LANG=""

# Empty/infer: schema/protocol policy; use diff/project rules only when empty.
export HOST_PROTO_POLICY=""

# Empty/infer: reviewer grep hints; use rules/globs/guards/diff only when empty.
export HOST_ARCHITECTURE_GREP_CHECKS=""

# Empty/noop: repo-relative HostWorkflowSpec JSON; empty keeps built-in behavior.
export HOST_WORKFLOW_SPEC=""

# Empty/noop: review diff source globs; host should fill for useful reviews.
export SOURCE_GLOBS="*.rs"                        # 例:*.cs *.proto / *.ts

# Fail-closed surface: required only for comment-monitor/direct-mention intake.
# Empty makes that surface stop instead of trusting unknown maintainers.
export MAINTAINER_WHITELIST="your-gh-handle"      # 例:alice bob
