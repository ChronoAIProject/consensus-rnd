#!/usr/bin/env python3
"""Transparent gh shim that records call accounting and delegates to real gh."""

from __future__ import annotations

import sys
from pathlib import Path


def _main() -> int:
    scripts_dir = Path(__file__).resolve().parents[1]
    sys.path.insert(0, str(scripts_dir))
    try:
        from codex_refactor_loop.gh_accounting import record_gh_call, run_real_gh
    except Exception:
        return _fallback_exec()
    argv = sys.argv[1:]
    exit_code = run_real_gh(argv, argv0=sys.argv[0])
    try:
        record_gh_call(argv, exit_code)
    except Exception:
        pass
    return exit_code


def _fallback_exec() -> int:
    import os
    import shutil
    import subprocess

    shim_dir = Path(__file__).resolve().parent
    path = os.pathsep.join(
        part
        for part in os.environ.get("PATH", "").split(os.pathsep)
        if part and Path(part).resolve() != shim_dir
    )
    real = shutil.which("gh", path=path)
    if real is None:
        sys.stderr.write("ghwrap: real gh not found after removing shim directory from PATH\n")
        return 127
    try:
        return subprocess.call([real, *sys.argv[1:]])
    except OSError as exc:
        sys.stderr.write(f"ghwrap: failed to exec real gh: {exc}\n")
        return 127


if __name__ == "__main__":
    raise SystemExit(_main())
