#!/usr/bin/env python3
"""Stable controller-facing CLI for consensus-loop."""

from __future__ import annotations

import sys


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "statusline":
        from codex_refactor_loop.statusline import main

        raise SystemExit(main(sys.argv[2:]))

    from codex_refactor_loop.cli import main

    raise SystemExit(main())
